{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-connect",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_BASE_URL": "https://connect.example.com",
    "MCP_BASE_URL": "https://mcp.connect.example.com",
    "ACCESS_ISSUER": "https://your-team.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-access-application-audience"
  }
}
