{
  "name": "agent-connect-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:gateway": "npm run dev --workspace @agent-connect/gateway",
    "dev:web": "npm run dev --workspace @agent-connect/web",
    "build:web": "npm run build --workspace @agent-connect/web",
    "build:sdk": "npm run build --workspace @agent-connect/server-sdk",
    "deploy": "npm run build:web && npm run deploy --workspace @agent-connect/gateway",
    "dev:notes": "npm run dev --workspace @agent-connect/example-notes-app",
    "dev:legacy": "npm run dev --workspace @agent-connect/example-legacy-api",
    "db:up": "docker compose up -d",
    "setup:dev": "node scripts/dev-setup.mjs"
  }
}
